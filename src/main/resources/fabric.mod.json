{
  "schemaVersion": 1,
  "id": "redstonenumbers",
  "version": "${version}",
  "name": "Redstone Numbers",
  "description": "Client-side camera-facing power numbers for redstone wire, using Minecraft's ordinary world text renderer.",
  "authors": [
    "TQNL contributors"
  ],
  "license": [
    "MIT",
    "CC-BY-NC-SA-4.0"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.tqnl.redstonenumbers.RedstoneNumbersClient"
    ],
    "modmenu": [
      "dev.tqnl.redstonenumbers.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "dev.tqnl.redstonenumbers.SodiumIntegration"
    ]
  },
  "mixins": [
    "redstonenumbers.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": ">=${fabric_api}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "icon": "assets/redstonenumbers/icon.png"
}
