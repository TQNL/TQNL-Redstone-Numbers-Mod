  "license": ["MIT", "CC-BY-NC-SA-4.0"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.tqnl.redstonenumbers.RedstoneNumbersClient"]
  },
  "mixins": ["redstonenumbers.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11"
  }
}
